NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id
NEXT_PUBLIC_FIREBASE_VAPID_KEY=your_firebase_web_push_vapid_key

# Server-side Firebase service account for FCM Web Push sending.
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your_project_id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour_private_key\n-----END PRIVATE KEY-----\n"

# Comma-separated Firebase Auth UIDs allowed to send admin notifications.
ADMIN_UIDS=operator_uid_1,operator_uid_2

# Public site URL used for OGP/canonical URLs. Set this to your Vercel production URL.
NEXT_PUBLIC_APP_URL=https://your-app-name.vercel.app

NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# Comma-separated Firebase Auth UIDs allowed to edit catches from the catch list.
NEXT_PUBLIC_CATCH_EDITOR_UIDS=operator_uid_1,operator_uid_2
NEXT_PUBLIC_PREMIUM_USER_UIDS=premium_uid_1,premium_uid_2

# Tide API. MVP uses Stormglass first. Keep provider as stormglass or worldtides.
TIDE_API_PROVIDER=stormglass
STORMGLASS_API_KEY=your_stormglass_api_key
WORLDTIDES_API_KEY=your_worldtides_api_key

# OpenAI API for AI catch reports.
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4.1-mini
